---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import FilteredCardGrid from '../../../components/ui/FilteredCardGrid.vue';
import { getCollection } from '../../../lib/cms';
import { getStrings, localePath, toLang, isRTL, UNPREFIXED_LOCALE, FALLBACK_LANGUAGES } from '../../../i18n';

const tenant = Astro.locals.tenant;
const lang = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback = tenant?.defaultLanguage;
const strings = getStrings(lang);

const allEvents = (await getCollection('events', Astro.locals.tenant?.id)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const secondaryLocale = FALLBACK_LANGUAGES.find((l) => l !== UNPREFIXED_LOCALE) ?? UNPREFIXED_LOCALE;
const categories = [
  { value: 'procedure', label: { [UNPREFIXED_LOCALE]: 'إجراء', [secondaryLocale]: 'Procedure' } },
  { value: 'event', label: { [UNPREFIXED_LOCALE]: 'حدث', [secondaryLocale]: 'Event' } },
  { value: 'announcement', label: { [UNPREFIXED_LOCALE]: 'إعلان', [secondaryLocale]: 'Announcement' } },
];

const items = allEvents.map((event) => ({
  id: event.id,
  slug: event.id,
  title: event.data.title,
  category: event.data.category,
  thumbnail: event.data.thumbnail,
  date: event.data.date.toISOString(),
  summary: event.data.summary,
}));

const breadcrumbs = [
  { label: strings.breadcrumb.home, href: localePath('/', lang) },
  { label: isRTL(lang) ? 'الفعاليات' : 'Events' },
];
---

<BaseLayout
  lang={lang}
  strings={strings}
  breadcrumbs={breadcrumbs}
  title={`${isRTL(lang) ? 'الفعاليات' : 'Events'} | ${strings.site.name}`}
  description={isRTL(lang) ? 'اكتشف فعاليات المستشفى وأحدث الأخبار الطبية' : 'Discover hospital events and latest medical news'}
>
  <SidebarLayout lang={lang} strings={strings} breadcrumbs={breadcrumbs}>
    <div class="mx-auto max-w-[1440px] px-6 pt-8">
      <PageHeader
        title={isRTL(lang) ? 'الفعاليات' : 'Events'}
        subtitle={isRTL(lang) ? 'تابع أحدث فعاليات المستشفى والبرامج الطبية' : 'Stay updated with hospital events and medical programs'}
      />
    </div>

    <section class="mx-auto max-w-[1440px] px-6 pb-12">
      <FilteredCardGrid
        client:visible
        items={items}
        categories={categories}
        lang={lang}
        defaultLanguage={fallback ?? FALLBACK_LANGUAGES[0]}
        basePath={localePath('/events', lang)}
        itemsPerPage={8}
        cardType="event"
      />
    </section>
  </SidebarLayout>
</BaseLayout>
