---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import FilteredCardGrid from '../../../components/ui/FilteredCardGrid.vue';
import { getCollection } from '../../../lib/cms';
import { getStrings, localePath, toLang, isRTL, UNPREFIXED_LOCALE, FALLBACK_LANGUAGES } from '../../../i18n';

const tenant = Astro.locals.tenant;
const lang = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback = tenant?.defaultLanguage;
const strings = getStrings(lang);

const allArticles = (await getCollection('articles', Astro.locals.tenant?.id)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

// Categories come from the CMS; fall back to the legacy fixed list if the collection isn't
// available yet (e.g. before the migration is applied).
const secondaryLocale = FALLBACK_LANGUAGES.find((l) => l !== UNPREFIXED_LOCALE) ?? UNPREFIXED_LOCALE;
let categories = [
  { value: 'hospital-news', label: { [UNPREFIXED_LOCALE]: 'أخبار المستشفى', [secondaryLocale]: 'Hospital News' } },
  { value: 'health-tips', label: { [UNPREFIXED_LOCALE]: 'نصائح صحية', [secondaryLocale]: 'Health Tips' } },
  { value: 'research', label: { [UNPREFIXED_LOCALE]: 'الأبحاث', [secondaryLocale]: 'Research' } },
  { value: 'events', label: { [UNPREFIXED_LOCALE]: 'الفعاليات', [secondaryLocale]: 'Events' } },
];
try {
  const cats = await getCollection('categories', Astro.locals.tenant?.id);
  if (cats.length) categories = cats.map((c) => ({ value: c.id, label: c.data.name }));
} catch { /* CMS without categories collection yet — keep the fallback */ }

const items = allArticles.map((article) => ({
  id: article.id,
  slug: article.id,
  title: article.data.title,
  category: article.data.category,
  thumbnail: article.data.thumbnail,
  date: article.data.date.toISOString(),
}));

const breadcrumbs = [
  { label: strings.breadcrumb.home, href: localePath('/', lang) },
  { label: isRTL(lang) ? 'المقالات' : 'Articles' },
];
---

<BaseLayout
  lang={lang}
  strings={strings}
  breadcrumbs={breadcrumbs}

  title={`${isRTL(lang) ? 'المقالات' : 'Articles'} | ${strings.site.name}`}
  description={isRTL(lang) ? 'اقرأ أحدث المقالات الطبية والأخبار من مستشفانا' : 'Read the latest medical articles and news from our hospital'}
>
  <SidebarLayout lang={lang} strings={strings} breadcrumbs={breadcrumbs}>
    <div class="mx-auto max-w-[1440px] px-6 pt-8">
      <PageHeader
        title={isRTL(lang) ? 'المقالات' : 'Articles'}
        subtitle={isRTL(lang) ? 'أحدث المقالات الطبية والمعلومات الصحية' : 'Latest medical articles and health information'}
      />
    </div>

    <section class="mx-auto max-w-[1440px] px-6 pb-12">
      <FilteredCardGrid
        client:visible
        items={items}
        categories={categories}
        lang={lang}
        defaultLanguage={fallback ?? FALLBACK_LANGUAGES[0]}
        basePath={localePath('/articles', lang)}
        itemsPerPage={8}
        cardType="article"
      />
    </section>
  </SidebarLayout>
</BaseLayout>
