---
import PortalLayout from "../../../layouts/PortalLayout.astro";
import PortalHome from "../../../components/portal/PortalHome.vue";
import { getStrings, toLang } from "../../../i18n";

const tenant = Astro.locals.tenant;
const lang = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback = tenant?.defaultLanguage;
const strings = getStrings(lang);
---
<PortalLayout
  lang={lang}
  strings={strings}
  title={`${strings.portal.title} | ${strings.site.name}`}
  description={strings.portal.description}
>
  <PortalHome lang={lang} strings={strings} client:load />
</PortalLayout>
