---
import PortalLayout from "../../../../layouts/PortalLayout.astro";
import PortalAppointments from "../../../../components/portal/PortalAppointments.vue";
import { getStrings, toLang, FALLBACK_LANGUAGES } from "../../../../i18n";

const tenant = Astro.locals.tenant;
const lang = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback = tenant?.defaultLanguage;
const strings = getStrings(lang);
const defaultLanguage = fallback ?? FALLBACK_LANGUAGES[0];
---
<PortalLayout
  lang={lang}
  strings={strings}
  title={`${strings.portal.appointments.title} | ${strings.site.name}`}
  description={strings.portal.appointments.description}
>
  <PortalAppointments lang={lang} strings={strings} defaultLanguage={defaultLanguage} client:load />
</PortalLayout>
