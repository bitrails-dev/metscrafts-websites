---
import PortalLayout from "../../../../layouts/PortalLayout.astro";
import PortalBook from "../../../../components/portal/PortalBook.vue";
import { getStrings, toLang, FALLBACK_LANGUAGES } from "../../../../i18n";

const tenant = Astro.locals.tenant;
const lang = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback = tenant?.defaultLanguage;
const strings = getStrings(lang);
const defaultLanguage = fallback ?? FALLBACK_LANGUAGES[0];
---
<PortalLayout
  lang={lang}
  strings={strings}
  title={`${strings.portal.book.title} | ${strings.site.name}`}
  description={strings.portal.book.description}
>
  <PortalBook lang={lang} strings={strings} defaultLanguage={defaultLanguage} client:load />
</PortalLayout>
