---
import BaseLayout from "../layouts/BaseLayout.astro";
import SidebarLayout from "../layouts/SidebarLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import MissionStrip from "../components/sections/MissionStrip.astro";
import AchievementsSection from "../components/sections/AchievementsSection.astro";
import DepartmentsSection from "../components/sections/DepartmentsSection.astro";
import TeamSection from "../components/sections/TeamSection.astro";
import TestimonialsSection from "../components/sections/TestimonialsSection.vue";
import AwardsWall from "../components/sections/AwardsWall.astro";
import AwardsListSection from "../components/sections/AwardsListSection.astro";
import { getStrings, FALLBACK_LANGUAGES, isRTL, toLang, type Locale } from "../i18n";

// Public root: Astro.params.lang is undefined here (prefixDefaultLocale: false). Route through
// toLang regardless so the resolved locale honours the tenant's published set + default.
const tenant = Astro.locals.tenant;
const lang: Locale = toLang(Astro.params.lang, tenant?.languages, tenant?.defaultLanguage);
const fallback: Locale | undefined = tenant?.defaultLanguage;
const strings = getStrings(lang);
const defaultLanguage: Locale = fallback ?? FALLBACK_LANGUAGES[0];

const breadcrumbs = [
  { label: isRTL(lang) ? "الرئيسية" : "Home" },
];
---

<BaseLayout lang={lang} strings={strings} title={strings.site.name} description={strings.site.description} breadcrumbs={breadcrumbs}>
  <SidebarLayout lang={lang} strings={strings} breadcrumbs={breadcrumbs}>
    <HeroSection lang={lang} strings={strings} stats={Astro.locals.healthcareSettings?.stats} defaultLanguage={defaultLanguage} />
    <DepartmentsSection lang={lang} strings={strings} defaultLanguage={defaultLanguage} />
    <MissionStrip strings={strings} lang={lang} defaultLanguage={defaultLanguage} />
    <AchievementsSection lang={lang} strings={strings} stats={Astro.locals.healthcareSettings?.stats} defaultLanguage={defaultLanguage} />
    <TeamSection lang={lang} strings={strings} defaultLanguage={defaultLanguage} />
    <TestimonialsSection strings={strings} items={strings.testimonials.items} lang={lang} client:visible />
    <AwardsWall lang={lang} strings={strings} defaultLanguage={defaultLanguage} />
    <AwardsListSection lang={lang} strings={strings} defaultLanguage={defaultLanguage} />
  </SidebarLayout>
</BaseLayout>
