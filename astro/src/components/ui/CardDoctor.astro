---
import CardBase from './CardBase.astro';

import { localePath, pickLocalized, type Locale } from '../../i18n';

interface Props {
  doctor: any;
  lang: Locale;
  certifiedLabel?: string;
  profileLabel?: string;
  imageAlt?: string;
  defaultLanguage: Locale;
}
const { doctor, lang, certifiedLabel, profileLabel, imageAlt, defaultLanguage } = Astro.props;
const fallback = defaultLanguage;
const name = pickLocalized(doctor.data.name, lang, fallback);
const specialty = pickLocalized(doctor.data.specialty, lang, fallback);
const href = localePath(`/doctors/${doctor.id}`, lang);

const imageBadge = doctor.data.certified
  ? {
      label: certifiedLabel,
      iconPath: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    }
  : undefined;
---

<CardBase
  href={href}
  image={doctor.data.photo}
  imageAlt={imageAlt ?? name}
  title={name}
  description={specialty}
  ctaLabel={profileLabel}
  imageBadge={imageBadge}
  horizontal={true}
/>
