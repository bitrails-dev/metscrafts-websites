---
import CardBase from './CardBase.astro';

import { localePath, pickLocalized, DATE_LOCALE_TAGS, type Locale } from '../../i18n';

interface Props {
  item: any;
  lang: Locale;
  categoryLabel?: string;
  readLabel?: string;
  defaultLanguage: Locale;
}
const { item, lang, categoryLabel, readLabel, defaultLanguage } = Astro.props;
const fallback = defaultLanguage;
const title = pickLocalized(item.data.title, lang, fallback);
const summary = pickLocalized(item.data.summary, lang, fallback);
const href = localePath(`/events/${item.id}`, lang);
const hasThumbnail = item.data.thumbnail && !item.data.thumbnail.includes('picsum');

const categoryColors: Record<string, string> = {
  procedure: 'bg-teal-700/10 text-teal-700',
  event: 'bg-navy-900/10 text-navy-900',
  announcement: 'bg-gold/15 text-gold',
};

const dateStr = item.data.date
  ? new Date(item.data.date).toLocaleDateString(DATE_LOCALE_TAGS[lang], {
      year: 'numeric', month: 'short', day: 'numeric',
    })
  : '';

const badges = categoryLabel
  ? [{ label: categoryLabel, color: categoryColors[item.data.category] ?? 'bg-ink-500/10 text-ink-500' }]
  : [];
---

<CardBase
  href={href}
  image={hasThumbnail ? item.data.thumbnail : undefined}
  imageAlt={title}
  date={dateStr}
  title={title}
  description={summary || undefined}
  ctaLabel={readLabel}
  badges={badges}
/>
