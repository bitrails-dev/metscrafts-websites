---
import CardBase from './CardBase.astro';
import { isRTL, pickLocalized, type Locale } from '../../i18n';

interface Props {
  staff: any;
  lang: Locale;
  defaultLanguage: Locale;
}
const { staff, lang, defaultLanguage } = Astro.props;
const fallback = defaultLanguage;
const name = pickLocalized(staff.data.name, lang, fallback);
const role = pickLocalized(staff.data.role, lang, fallback);

const badges = staff.data.featured
  ? [{ label: isRTL(lang) ? 'رئيسية' : 'Chief', color: 'bg-teal-700/10 text-teal-700' }]
  : [];
---

<CardBase title={name} description={role} badges={badges}>
  <div slot="icon" class="flex h-14 w-14 items-center justify-center bg-navy-900/10 mx-auto mb-1">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-navy-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
      <circle cx="12" cy="7" r="4"/>
    </svg>
  </div>
</CardBase>
