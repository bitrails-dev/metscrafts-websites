---
import { DEFAULT_LOCALE } from '../../i18n';
const { url } = Astro.props;
// Static redirect stub: locale is always the unprefixed default (the only caller is the bare
// Arabic-root redirect). Derive the code from the catalogue rather than inlining a literal.
const lang = DEFAULT_LOCALE;
---
<html lang={lang} dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content={`0;url=${url}`} />
  <link rel="canonical" href={url} />
</head>
<body>
  <p style="text-align:center;padding:2rem;font-family:system-ui">جاري التحويل...</p>
</body>
</html>
