# Container runtime config for docker/supervisor.mjs. Copy to docker/.env and edit.
# Build:   docker build -f docker/Dockerfile -t dgh-site .
# Run:     docker run --rm -p 4321:4321 --env-file docker/.env -v dgh-data:/data dgh-site

# --- Required ---
# Payload session/JWT secret (>=32 chars). Generate: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Dev/smoke ONLY: if you can't pass PAYLOAD_SECRET to docker (some Docker setups — e.g. a secret
# interceptor — hang on any env name or file contents matching *SECRET*), set AUTOGEN_KEY=1 and the
# supervisor mints an EPHEMERAL secret at boot. Sessions/signed tokens will NOT survive a restart,
# so never use this in production.
# AUTOGEN_KEY=1
# Public URL of the Astro site (used by Payload for CSRF/serverURL so the proxied admin works).
PUBLIC_SITE=http://localhost:4321
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4321

# --- Astro (public site) ---
# off = don't run Astro | in-process = embed Payload Local API for reads (default) | api = read over HTTP from the CMS
ASTRO_MODE=in-process
# Start Astro at container boot (false only makes sense for a CMS-only container).
ASTRO_AUTOSTART=true

# --- Payload dashboard (the Next.js CMS app that serves /admin) ---
# on = always running | off = disabled (the /admin route returns 503) | inactivity-timeout = launch on demand, idle-shut (default)
PAYLOAD_MODE=inactivity-timeout
# Start the dashboard at boot instead of on first /admin hit.
PAYLOAD_AUTOSTART=false
# Idle window before an on-demand dashboard is shut down (inactivity-timeout mode only). 900000 = 15 min.
PAYLOAD_INACTIVITY_TIMEOUT_MS=900000
# Run `payload migrate` before any process opens the DB. Safe to leave on (idempotent).
PAYLOAD_MIGRATE_ON_BOOT=true
# Seed the default "damietta-general-hospital" tenant on a fresh DB (idempotent) so the first admin
# can be created via /admin. Safe to leave on; no-op once the tenant exists.
PAYLOAD_SEED_ON_BOOT=true

# --- Ports (inside the container) ---
ASTRO_PORT=4321
CMS_PORT=3001
CONTROL_PORT=9223

# --- Database ---
# Default is a volume-mounted SQLite file at /data/cms.db (persistent across restarts).
DATABASE_URI=file:/data/cms.db
DATABASE_AUTH_TOKEN=

# --- Commerce / social keys (copy from cms/.env.example as needed) ---
# COMMERCE_GATEWAY_KEY_ID= ... etc. Only required if those features are enabled.
